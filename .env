# DSA360 – Multi-Tenant SaaS – 2025 Production .env
# NEVER commit this file → must be in .gitignore

# MySQL Configuration
MYSQL_ROOT_PASSWORD=admin
MYSQL_DATABASE=dsa360_master

# Spring Boot Configuration
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=admin
SPRING_DATASOURCE_URL=jdbc:mysql://mysqldb:3306/dsa360_master?createDatabaseIfNotExist=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=UTC
SPRING_PROFILES_ACTIVE=dev